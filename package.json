{
  "name": "sidequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "tsc -b && vite build --mode github --configLoader runner && node scripts/build-service-worker.mjs --pages",
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner && node scripts/build-service-worker.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
